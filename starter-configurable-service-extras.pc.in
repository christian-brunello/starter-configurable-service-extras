prefix=@prefix@
exec_prefix=@exec_prefix@
libdir=@libdir@
includedir=@includedir@

Name: @PACKAGE_NAME@
Description: STARTER Configurable Service extras (process helpers and out-of-tree plugins)
Version: @PACKAGE_VERSION@
Requires: starter-configurable-service
Cflags: -I${includedir}
Libs: -L${libdir}
